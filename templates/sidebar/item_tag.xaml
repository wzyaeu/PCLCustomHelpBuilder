<Border CornerRadius="5"
        Margin="{indent},5,0,0">
    <Border.Style>
        <Style TargetType="Border">
            <Setter Property="Background"
                    Value="{DynamicResource ColorBrush6}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource ColorBrush5}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Border.Style>
    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Margin="5"
                       VerticalAlignment="Center"
                       FontSize="15"
                       Foreground="{DynamicResource ColorBrush1}"
                       Text="{name}"/>
            <Border CornerRadius="5,3,3,5"
                Margin="0,0,2,0"
                    Grid.Column="2"
                    Background="{DynamicResource ColorBrush4}"
                    VerticalAlignment="Center">
                <TextBlock Margin="5"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource ColorBrush8}"
                           Text="当前"/>
            </Border>
        </Grid>
        <local:MyButton Opacity="0"
                        EventType="打开帮助"
                        EventData="{url}"/>
    </Grid>
</Border>