<Border CornerRadius="5"
        Margin="{indent},5,0,0">
    <Border.Style>
        <Style TargetType="Border">
            <Setter Property="Background"
                    Value="{DynamicResource ColorBrush6}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                        Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource ColorBrush5}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Border.Style>
    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Margin="5"
                    VerticalAlignment="Center"
                    FontSize="15"
                    Foreground="{DynamicResource ColorBrush1}"
                    Text="{name}"/>
            <Path Margin="0,0,10,0"
                  Grid.Column="2"
                  Width="15"
                  Height="15"
                  VerticalAlignment="Center"
                  Stretch="Uniform"
                  Fill="{DynamicResource ColorBrush1}"
                  Data="M782.8 511.1 351.9 942c-22.8 22.8-59.8 22.8-82.6 0-22.8-22.8-22.8-59.8 0-82.6L617.5 511.1 269.2 162.8c-22.8-22.8-22.8-59.8 0-82.6 22.8-22.8 59.8-22.8 82.6 0L782.8 511.1 782.8 511.1zM782.8 511.1">
                <Path.RenderTransform>
                    <RotateTransform Angle="90" CenterX="5" CenterY="7.5"/>
                </Path.RenderTransform>
            </Path>
        </Grid>
        <local:MyButton Opacity="0"
                EventType="打开帮助"
                EventData="{url}"/>
    </Grid>
</Border>